<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <HookPath Condition="'$(HookPath)' == ''">$(MSBuildThisFileDirectory)../../lyricify-hook/bin/Release/net6.0/StartupHook.dll</HookPath>
    <HookDirectory>$([System.IO.Path]::GetDirectoryName('$(HookPath)'))</HookDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="StartupHook"><HintPath>$(HookPath)</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(HookDirectory)/0Harmony.dll</HintPath></Reference>
    <Reference Include="SpotifyAPI.Web"><HintPath>$(SpotifyApiDll)</HintPath></Reference>
  </ItemGroup>
</Project>
