<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LyricifyLauncher</AssemblyName>
    <PayloadDirectory Condition="'$(PayloadDirectory)' == ''">$(MSBuildThisFileDirectory)..\lyricify-hook\bin\Release\net6.0</PayloadDirectory>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PayloadDirectory)/StartupHook.dll" LogicalName="SpotifyLocalBridge.Payload.StartupHook.dll" />
    <EmbeddedResource Include="$(PayloadDirectory)/StartupHook.deps.json" LogicalName="SpotifyLocalBridge.Payload.StartupHook.deps.json" />
    <EmbeddedResource Include="$(PayloadDirectory)/0Harmony.dll" LogicalName="SpotifyLocalBridge.Payload.0Harmony.dll" />
    <EmbeddedResource Include="$(PayloadDirectory)/System.Text.Json.dll" LogicalName="SpotifyLocalBridge.Payload.System.Text.Json.dll" />
    <EmbeddedResource Include="../spotify-local-bridge.js" LogicalName="SpotifyLocalBridge.Payload.spotify-local-bridge.js" />
    <EmbeddedResource Include="../install.ps1" LogicalName="SpotifyLocalBridge.Payload.install.ps1" />
    <EmbeddedResource Include="../uninstall.ps1" LogicalName="SpotifyLocalBridge.Payload.uninstall.ps1" />
  </ItemGroup>
</Project>
